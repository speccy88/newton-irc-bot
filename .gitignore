PROGRESS.md

# Live configuration — ship the example, not your own.
config.json

# Operator secrets / identifiers — never commit.
.env
*.env
operator_denylist.txt
*.key
*.pem

# Local survey + operational notes (not part of the reusable bot).
survey*.md
survey*.json
survey*.py
sync.log

# Backups and build artifacts.
*.bak
__pycache__/
venv/
.muse-github-snapshot-sync.json
